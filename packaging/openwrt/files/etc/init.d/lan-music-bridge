#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load lan-music-bridge
	local enabled config_path
	config_get_bool enabled main enabled 0
	config_get config_path main config_path /etc/lan-music-bridge/config.toml
	[ "$enabled" -eq 1 ] || return 0
	[ -r "$config_path" ] || return 1

	procd_open_instance
	procd_set_param env PYTHONPATH=/usr/libexec/lan-music-bridge
	procd_set_param command /usr/bin/python3 -m lan_music_bridge --config "$config_path" serve
	procd_set_param file "$config_path"
	procd_set_param respawn 5 30 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lan-music-bridge
}
